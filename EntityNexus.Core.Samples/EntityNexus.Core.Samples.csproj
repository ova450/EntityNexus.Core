<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EntityNexus.Core.Samples</AssemblyName>
    <PackageId>EntityNexus.Core.Samples</PackageId>
    <RootNamespace>EntityNexus.Samples.Core</RootNamespace>
    <Authors>ovaataaridotru</Authors>
    <PackageTags>entity; orm; domain; dsl; framework</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Description>Tests domain models for EntityNexus DSL Framework.</Description>

    <RepositoryUrl>https://github.com/ova450/EntityNexus.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <OutputType>Exe</OutputType>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityNexus.Core.AbstractClasses\EntityNexus.Core.AbstractClasses.csproj" />
  </ItemGroup>

</Project>